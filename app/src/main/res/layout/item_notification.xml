<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_white_rounded"
    android:elevation="2dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivNotifIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_bell"
        android:background="@drawable/bg_pink_trans_rounded"
        android:padding="10dp"
        app:tint="@color/brand_purple"
        android:contentDescription="Notification"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lượt thích mới"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvNotifContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minh Anh đã gửi Super Like cho bạn! ⭐"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10 phút trước"
            android:textSize="11sp"
            android:textColor="@color/brand_purple"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

</LinearLayout>
