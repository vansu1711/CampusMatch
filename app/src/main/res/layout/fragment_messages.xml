<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp">

        <!-- Top Glow Background -->
        <View
            android:id="@+id/viewHeaderGlow"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_brand_gradient"
            android:alpha="0.1"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Header Bar -->
        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_campus_logo"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus Match"
            android:textColor="@color/brand_purple"
            android:textSize="20sp"
            android:fontFamily="cursive"
            android:textStyle="bold|italic"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintStart_toEndOf="@id/ivHeaderLogo"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvMessagesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tin nhắn &amp; Matches"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Matches Section Title -->
        <TextView
            android:id="@+id/tvLabelNewMatches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💕 Matches mới nhất"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvMessagesTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- New Matches Horizontal Row -->
        <HorizontalScrollView
            android:id="@+id/scrollNewMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tvLabelNewMatches">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Match Item 1 -->
                <LinearLayout
                    android:id="@+id/matchItem1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/bg_gradient"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="@color/brand_pink"
                        app:strokeWidth="2dp"
                        tools:src="@tools:sample/avatars"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minh Anh"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Match Item 2 -->
                <LinearLayout
                    android:id="@+id/matchItem2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/bg_gradient"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="@color/brand_purple"
                        app:strokeWidth="2dp"
                        tools:src="@tools:sample/avatars"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bảo Ngọc"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Match Item 3 -->
                <LinearLayout
                    android:id="@+id/matchItem3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/bg_gradient"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="@color/brand_pink"
                        app:strokeWidth="2dp"
                        tools:src="@tools:sample/avatars"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khánh Linh"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Recent Conversations Section Title -->
        <TextView
            android:id="@+id/tvLabelRecentConversations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 Trò chuyện gần đây"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/scrollNewMatches"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Conversations RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvLabelRecentConversations"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
