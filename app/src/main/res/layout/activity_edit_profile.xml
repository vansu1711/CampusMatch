<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@color/white"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnEditBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_revert"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay lại"
                app:tint="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa hồ sơ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_centerInParent="true"/>

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Lưu"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_brand_gradient"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar Image Container -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivEditAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_gradient"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    tools:src="@tools:sample/avatars"/>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_edit"
                    android:background="@drawable/bg_white_rounded"
                    android:padding="4dp"
                    android:elevation="4dp"
                    app:tint="@color/brand_purple"
                    android:contentDescription="Đổi ảnh"/>
            </FrameLayout>

            <!-- Name Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên hiển thị"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập tên hiển thị"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:inputType="textPersonName"
                android:autofillHints=""/>

            <!-- Age Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuổi"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditAge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập tuổi"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:inputType="number"
                android:autofillHints=""/>

            <!-- Location Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nơi ở / Vị trí"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ví dụ: Thủ Đức, TP.HCM"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:autofillHints=""/>

            <!-- School Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trường Đại học"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditSchool"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ví dụ: ĐH Bách Khoa - ĐHQG TP.HCM"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:autofillHints=""/>

            <!-- Major Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngành học"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditMajor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ví dụ: 💻 Công nghệ Thông tin"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:inputType="text"
                android:autofillHints=""/>

            <!-- Bio Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giới thiệu bản thân (Bio)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditBio"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:hint="Viết ngắn vài dòng về bản thân bạn..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:padding="14dp"
                android:textSize="14sp"
                android:gravity="top|start"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:inputType="textMultiLine"
                android:autofillHints=""/>

            <!-- Interests Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sở thích (Phân cách bằng dấu phẩy)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <EditText
                android:id="@+id/etEditInterests"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ví dụ: 💻 Coding, ☕ Cà phê, 🎸 Guitar, 🏋️ Gym"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_edittext"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:inputType="text"
                android:autofillHints=""/>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
