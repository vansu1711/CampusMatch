<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Glow / Gradient Background Header -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_brand_gradient"
        android:alpha="0.1"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- App Bar / Header -->
    <ImageView
        android:id="@+id/ivHeaderLogo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_campus_logo"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campus Match"
        android:textColor="@color/brand_purple"
        android:textSize="20sp"
        android:fontFamily="cursive"
        android:textStyle="bold|italic"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintStart_toEndOf="@id/ivHeaderLogo"/>

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_bell"
        app:tint="@color/brand_purple"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintEnd_toStartOf="@id/btnFilter"/>

    <!-- Filter Action Button Header -->
    <ImageView
        android:id="@+id/btnFilter"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_filter"
        app:tint="@color/brand_purple"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Bộ lọc"
        app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tìm người hợp vibe\nvới bạn ♡"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Filter Bar -->
    <HorizontalScrollView
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvMainTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Filter Chips for Interests, Location, Age -->
            <TextView
                android:id="@+id/chipInterest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎸 Sở thích"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/white"
                android:padding="10dp"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Nơi ở"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:padding="10dp"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎂 Độ tuổi"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:padding="10dp"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty State View when filter has no results -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toTopOf="@id/actionButtons">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="48sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Không tìm thấy hồ sơ phù hợp"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thử mở rộng các tiêu chí bộ lọc về sở thích, nơi ở hoặc độ tuổi để tìm thêm bạn nhé!"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp"/>

        <Button
            android:id="@+id/btnResetFilter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="🔄 Đặt lại bộ lọc"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@drawable/bg_brand_gradient"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
    </LinearLayout>

    <!-- Profile Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toTopOf="@id/actionButtons">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_gradient"
                tools:src="@tools:sample/avatars"/>

            <!-- Photo Indicator Progress Bars (Tinder Style) -->
            <LinearLayout
                android:id="@+id/layoutPhotoIndicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:elevation="4dp">

                <View
                    android:id="@+id/indicatorBar1"
                    android:layout_width="0dp"
                    android:layout_height="3.5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_rounded"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/indicatorBar2"
                    android:layout_width="0dp"
                    android:layout_height="3.5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_rounded"
                    android:alpha="0.4"
                    android:layout_marginEnd="4dp"/>

                <View
                    android:id="@+id/indicatorBar3"
                    android:layout_width="0dp"
                    android:layout_height="3.5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_white_rounded"
                    android:alpha="0.4"/>
            </LinearLayout>

            <!-- Touch Overlay Areas to Swipe/Tap Photos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:elevation="2dp">

                <!-- Left Tap (Previous Photo) -->
                <View
                    android:id="@+id/viewTapLeft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Right Tap (Next Photo) -->
                <View
                    android:id="@+id/viewTapRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Gradient overlay for text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_gravity="bottom"
                android:elevation="3dp"
                android:background="@drawable/bg_card_overlay"/>

            <!-- Profile Info on Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minh Anh, 20 ✓"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvProfileMajor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏢 Công nghệ thông tin - Bách Khoa"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:alpha="0.9"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/tvProfileLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Thủ Đức, TP.HCM"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:alpha="0.85"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:id="@+id/layoutInterestsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvInterest1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☕ Cà phê"
                        android:background="@drawable/bg_white_trans_rounded"
                        android:textColor="@color/white"
                        android:padding="6dp"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tvInterest2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎸 Guitar"
                        android:background="@drawable/bg_white_trans_rounded"
                        android:textColor="@color/white"
                        android:padding="6dp"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tvInterest3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈️ Du lịch"
                        android:background="@drawable/bg_white_trans_rounded"
                        android:textColor="@color/white"
                        android:padding="6dp"
                        android:textSize="11sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMatchPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💗 92% hợp nhau"
                    android:background="@drawable/bg_pink_trans_rounded"
                    android:textColor="#FF2D55"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons (X, Star, Heart) -->
    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnPass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            app:tint="#FF3B30"
            app:backgroundTint="@color/white"
            app:fabSize="normal"
            android:layout_marginEnd="24dp"
            app:elevation="4dp"
            android:contentDescription="Pass"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSuperLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            app:tint="#FFCC00"
            app:backgroundTint="@color/white"
            app:fabSize="mini"
            android:layout_marginEnd="24dp"
            app:elevation="4dp"
            android:contentDescription="Super Like"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_heart"
            app:tint="@color/white"
            app:backgroundTint="#FF2D55"
            app:fabSize="normal"
            app:elevation="4dp"
            android:contentDescription="Like"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
