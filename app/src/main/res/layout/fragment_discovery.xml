<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Top Glow / Gradient Background Header -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_brand_gradient"
        android:alpha="0.1"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- App Bar / Header -->
    <ImageView
        android:id="@+id/ivHeaderLogo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_campus_logo"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campus Match"
        android:textColor="@color/brand_purple"
        android:textSize="20sp"
        android:fontFamily="cursive"
        android:textStyle="bold|italic"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintStart_toEndOf="@id/ivHeaderLogo"/>

    <ImageView
        android:id="@+id/ivBell"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_bell"
        app:tint="@color/brand_purple"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
        app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- School Filter Button -->
    <LinearLayout
        android:id="@+id/layoutSchoolSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_white_rounded"
        android:padding="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_school"
            app:tint="@color/brand_purple"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐHQG TP.HCM"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"/>

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@android:drawable/arrow_down_float"
            app:tint="@color/text_secondary"/>
    </LinearLayout>

    <!-- Main Title -->
    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tìm người hợp vibe\nvới bạn ♡"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSchoolSelect"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Filter Bar -->
    <HorizontalScrollView
        android:id="@+id/filterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvMainTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Filter Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 Cùng trường"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/white"
                android:padding="10dp"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎸 Sở thích"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:padding="10dp"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Gần bạn"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:padding="10dp"
                android:textSize="12sp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Profile Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/filterBar"
        app:layout_constraintBottom_toTopOf="@id/actionButtons">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_gradient"
                tools:src="@tools:sample/avatars"/>

            <!-- Gradient overlay for text readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_card_overlay"/>

            <!-- Profile Info on Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minh Anh, 20 ✓"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvProfileMajor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏢 Công nghệ thông tin"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:alpha="0.9"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☕ Cà phê"
                        android:background="@drawable/bg_white_trans_rounded"
                        android:textColor="@color/white"
                        android:padding="6dp"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎸 Guitar"
                        android:background="@drawable/bg_white_trans_rounded"
                        android:textColor="@color/white"
                        android:padding="6dp"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈️ Du lịch"
                        android:background="@drawable/bg_white_trans_rounded"
                        android:textColor="@color/white"
                        android:padding="6dp"
                        android:textSize="11sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💗 92% hợp nhau"
                    android:background="@drawable/bg_pink_trans_rounded"
                    android:textColor="#FF2D55"
                    android:padding="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons (X, Star, Heart) -->
    <LinearLayout
        android:id="@+id/actionButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_close"
            app:tint="#FF3B30"
            app:backgroundTint="@color/white"
            app:fabSize="normal"
            android:layout_marginEnd="24dp"
            app:elevation="4dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_star"
            app:tint="#FFCC00"
            app:backgroundTint="@color/white"
            app:fabSize="mini"
            android:layout_marginEnd="24dp"
            app:elevation="4dp"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_heart"
            app:tint="@color/white"
            app:backgroundTint="#FF2D55"
            app:fabSize="normal"
            app:elevation="4dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>