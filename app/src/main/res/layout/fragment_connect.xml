<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp">

        <!-- Header Background Glow -->
        <View
            android:id="@+id/viewConnectHeaderGlow"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@drawable/bg_brand_gradient"
            android:alpha="0.1"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Header Bar -->
        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_campus_logo"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus Match"
            android:textColor="@color/brand_purple"
            android:textSize="20sp"
            android:fontFamily="cursive"
            android:textStyle="bold|italic"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintStart_toEndOf="@id/ivHeaderLogo"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvConnectTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ai đã thích bạn 💕"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvConnectSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bấm 'Thích lại' để Match ngay, hoặc chạm vào để xem thông tin chi tiết hồ sơ!"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvConnectTitle"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutNoPendingLikes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/tvConnectSubtitle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💌"
                android:textSize="48sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có lượt thích mới"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hãy tích cực quẹt thẻ ở mục Khám phá để kết nối được nhiều bạn sinh viên hơn nhé!"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Pending Likes RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingLikes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvConnectSubtitle"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
