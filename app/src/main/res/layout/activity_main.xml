<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Discovery Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDiscoveryContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Gradient Header matching Login screen tone -->
        <View
            android:id="@+id/topGlow"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_main_header_gradient"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- App Header Bar -->
        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_campus_logo"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Campus Match"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:fontFamily="cursive"
            android:textStyle="bold|italic"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintStart_toEndOf="@id/ivHeaderLogo"/>

        <!-- Bell Icon with Notification Badge -->
        <FrameLayout
            android:id="@+id/layoutBell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="@id/ivHeaderLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivBell"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bell"
                app:tint="@android:color/white"/>

            <!-- Red Badge Dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_pink_trans_rounded"
                android:backgroundTint="@color/accent_red"/>
        </FrameLayout>

        <!-- School Filter Button -->
        <LinearLayout
            android:id="@+id/layoutSchoolSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_rounded"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            android:elevation="3dp"
            app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_school"
                app:tint="@color/brand_purple"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐHQG TP.HCM"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"/>

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="@color/text_secondary"/>
        </LinearLayout>

        <!-- Main Title -->
        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm người hợp vibe\nvới bạn ♡"
            android:textColor="@color/brand_purple_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/layoutSchoolSelect"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Filter Bar -->
        <HorizontalScrollView
            android:id="@+id/filterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/tvMainTitle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Filter Chips -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓 Cùng trường"
                    android:background="@drawable/bg_chip_selected"
                    android:textColor="@color/white"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Sở thích"
                    android:background="@drawable/bg_chip_unselected"
                    android:textColor="@color/text_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Gần bạn"
                    android:background="@drawable/bg_chip_unselected"
                    android:textColor="@color/text_primary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12sp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Profile Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/filterBar"
            app:layout_constraintBottom_toTopOf="@id/actionButtons">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Profile Image Container -->
                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_gradient"
                    tools:src="@tools:sample/avatars"/>

                <!-- Count Badge "1/5" at top right of image -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/5"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_unselected"
                    android:backgroundTint="#80000000"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="16dp"/>

                <!-- Profile Info Card Section at Bottom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="16dp">

                    <!-- Name & Age with Verified Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Minh Anh, 20"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_verified"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- Major / University -->
                    <TextView
                        android:id="@+id/tvProfileMajor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏛 Công nghệ thông tin"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                    <!-- Interests Tags -->
                    <LinearLayout
                        android:id="@+id/layoutInterestsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvInterest1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☕ Cà phê"
                            android:background="@drawable/bg_white_trans_rounded"
                            android:textColor="@color/text_primary"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/tvInterest2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎸 Guitar"
                            android:background="@drawable/bg_white_trans_rounded"
                            android:textColor="@color/text_primary"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="11sp"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/tvInterest3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✈️ Du lịch"
                            android:background="@drawable/bg_white_trans_rounded"
                            android:textColor="@color/text_primary"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Match Percentage Badge -->
                    <TextView
                        android:id="@+id/tvMatchPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💖 92% hợp nhau"
                        android:background="@drawable/bg_pink_trans_rounded"
                        android:textColor="@color/brand_pink"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons (X, Star, Heart) -->
        <LinearLayout
            android:id="@+id/actionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Pass Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close"
                app:tint="@color/accent_red"
                app:backgroundTint="@color/white"
                app:fabCustomSize="56dp"
                android:layout_marginEnd="20dp"
                app:elevation="4dp"
                android:contentDescription="Pass"/>

            <!-- Super Like Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSuperLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_star"
                app:tint="@color/accent_yellow"
                app:backgroundTint="@color/white"
                app:fabCustomSize="48dp"
                android:layout_marginEnd="20dp"
                app:elevation="4dp"
                android:contentDescription="Super Like"/>

            <!-- Like Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_heart"
                app:tint="@color/white"
                app:backgroundTint="@color/brand_pink"
                app:fabCustomSize="64dp"
                app:elevation="6dp"
                android:contentDescription="Like"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Overlay Fragment Container for tab navigation -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled" />

</androidx.constraintlayout.widget.ConstraintLayout>